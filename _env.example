# انسخ هذا الملف إلى .env واملأ القيم. لا تضع أسراراً حقيقية هنا.

# --- Neon PostgreSQL (من Neon Dashboard > Connect) ---
# Pooled: الرابط الذي يحتوي -pooler (يستخدمه التطبيق)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct: نفس الرابط بدون -pooler (يستخدمه prisma db push)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Security (لكل واحد: openssl rand -hex 32) ---
APP_SECRET="change-me-64-hex"
ENCRYPTION_KEY="change-me-64-hex"
CRON_SECRET="change-me-long-random"

# --- Public URL ---
APP_URL="https://your-domain.com"

# --- Email (Resend). اختياري: يمكن إضافته من Admin > Email ---
RESEND_API_KEY=""
RESEND_FROM="OTPProvider <no-reply@your-domain.com>"
RESEND_WEBHOOK_SECRET=""
CONTACT_EMAIL=""

# --- First Super Admin (يستخدمه npm run db:seed فقط، محلياً) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThisNow!2026"
