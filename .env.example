# --- Neon PostgreSQL (copy from Neon dashboard) ---
# Pooled connection (host contains -pooler) used by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection used by `prisma db push`
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Security (generate: openssl rand -hex 32) ---
APP_SECRET="change-me-64-hex"
ENCRYPTION_KEY="change-me-64-hex"
CRON_SECRET="change-me-long-random"

# --- Public URL ---
APP_URL="https://otpprovider.com"

# --- Email (Resend). Optional: can also be added from Admin > Email ---
RESEND_API_KEY=""
RESEND_FROM="OTPProvider <no-reply@otpprovider.com>"

# --- First Super Admin (used ONLY by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThisNow!2026"
