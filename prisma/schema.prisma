generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE
  SUPPORT
  CLIENT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RESTRICTED
  CLOSED
}

enum ServiceKey {
  EMAIL_OTP
  WHATSAPP_OTP
  EMAIL_VALIDATION
}

enum ServiceState {
  ENABLED
  DISABLED
  DEGRADED
}

enum BillOn {
  SUBMITTED
  DELIVERED
}

enum MsgStatus {
  QUEUED
  PROCESSING
  SUBMITTED
  SENT
  DELIVERED
  READ
  REJECTED
  FAILED
  EXPIRED
  UNKNOWN_OUTCOME
}

enum LedgerType {
  TOPUP
  USAGE
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum TopupStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeviceStatus {
  PAIRING
  CONNECTED
  DISCONNECTED
  PAUSED
}

enum CommandType {
  REFRESH_QR
  DISCONNECT
  RECONNECT
  TEST_MESSAGE
}

enum TicketStatus {
  OPEN
  WAITING
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Tenant {
  id               String        @id @default(cuid())
  name             String
  status           AccountStatus @default(ACTIVE)
  packageId        String?
  package          Package?      @relation(fields: [packageId], references: [id])
  balance          Decimal       @default(0) @db.Decimal(18, 6)
  allowNegative    Boolean       @default(false)
  serviceOverrides Json          @default("{}")
  priceOverrides   Json          @default("{}")
  pinnedDeviceId   String?
  senderId         String?
  assignedSupportId String?
  adminNote        String?
  createdAt        DateTime      @default(now())
  users            User[]
  apiKeys          ApiKey[]
  ledger           LedgerEntry[]
  topups           TopupRequest[]
  messages         MessageRequest[]
  validations      EmailValidation[]
  tickets          Ticket[]
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(CLIENT)
  status       AccountStatus @default(ACTIVE)
  tenantId     String?
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  emailVerified Boolean      @default(false)
  mfaSecretEnc String?
  mfaEnabled   Boolean       @default(false)
  failedLogins Int           @default(0)
  lockedUntil  DateTime?
  locale       String        @default("en")
  extraPerms   String[]      @default([])
  mustChangePassword Boolean @default(false)
  createdById  String?
  createdAt    DateTime      @default(now())
  sessions     Session[]
  tokens       AuthToken[]

  @@index([role])
  @@index([tenantId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  mfaVerified Boolean   @default(false)
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // VERIFY_EMAIL | RESET_PASSWORD
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label      String
  prefix     String
  hash       String    @unique
  services   String[]  @default([])
  rateLimit  Int       @default(60)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  messages   MessageRequest[]

  @@index([tenantId])
}

model Package {
  id              String   @id @default(cuid())
  name            String
  priceUsd        Decimal  @db.Decimal(12, 2)
  emailQuota      Int      @default(0)
  whatsappQuota   Int      @default(0)
  validationQuota Int      @default(0)
  custom          Boolean  @default(false)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  tenants         Tenant[]
}

model ServiceConfig {
  key        ServiceKey   @id
  state      ServiceState @default(DISABLED)
  unitPrice  Decimal      @default(0.01) @db.Decimal(12, 6)
  billOn     BillOn       @default(SUBMITTED)
  dailyLimit Int          @default(100000)
  ttlSeconds Int          @default(300)
  settings   Json         @default("{}")
  updatedAt  DateTime     @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model LedgerEntry {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  type         LedgerType
  amount       Decimal    @db.Decimal(18, 6)
  balanceAfter Decimal    @db.Decimal(18, 6)
  ref          String?    @unique
  reason       String?
  requestId    String?
  createdById  String?
  createdAt    DateTime   @default(now())

  @@index([tenantId, createdAt])
}

model TopupRequest {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  amount      Decimal     @db.Decimal(12, 2)
  method      String
  reference   String?
  note        String?
  status      TopupStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([tenantId])
  @@index([status])
}

model MessageRequest {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  apiKeyId        String?
  apiKey          ApiKey?   @relation(fields: [apiKeyId], references: [id])
  service         ServiceKey
  idempotencyKey  String?
  senderRef       String?
  senderLabel     String?
  recipient       String
  status          MsgStatus @default(QUEUED)
  providerMessageId String?
  providerName    String?
  errorCode       String?
  errorMessage    String?
  charge          Decimal   @default(0) @db.Decimal(12, 6)
  codeHash        String?
  codeAttempts    Int       @default(0)
  verifiedAt      DateTime?
  expiresAt       DateTime?
  bodyEnc         String?
  deviceId        String?
  device          WhatsAppDevice? @relation(fields: [deviceId], references: [id])
  template        String?
  durationMs      Int?
  createdAt       DateTime  @default(now())
  submittedAt     DateTime?
  deliveredAt     DateTime?
  attempts        MessageAttempt[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([status, service])
  @@index([deviceId, status])
}

model MessageAttempt {
  id        String         @id @default(cuid())
  messageId String
  message   MessageRequest @relation(fields: [messageId], references: [id], onDelete: Cascade)
  provider  String
  outcome   String
  response  String?
  createdAt DateTime       @default(now())

  @@index([messageId])
}

model EmailProvider {
  id         String        @id @default(cuid())
  name       String
  kind       String        @default("RESEND")
  apiKeyEnc  String?
  enabled    Boolean       @default(true)
  priority   Int           @default(1)
  lastStatus String?
  lastCheck  DateTime?
  createdAt  DateTime      @default(now())
  senders    EmailSender[]
}

model EmailSender {
  id          String        @id @default(cuid())
  providerId  String
  provider    EmailProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  address     String        @unique
  displayName String
  verified    Boolean       @default(false)
  active      Boolean       @default(true)
  services    String[]      @default(["EMAIL_OTP"])
  dailyLimit  Int           @default(10000)
  note        String?
  lastUsedAt  DateTime?
  createdAt   DateTime      @default(now())
}

model WhatsAppDevice {
  id              String       @id @default(cuid())
  label           String
  phone           String?
  status          DeviceStatus @default(DISCONNECTED)
  enabled         Boolean      @default(true)
  tokenHash       String       @unique
  qr              String?
  qrAt            DateTime?
  lastHeartbeat   DateTime?
  lastConnectedAt DateTime?
  lastError       String?
  lastTestAt      DateTime?
  gatewayVersion  String?
  dailyLimit      Int          @default(500)
  sentToday       Int          @default(0)
  sentTodayDate   String?
  priority        Int          @default(1)
  sessionEnc      String?
  createdAt       DateTime     @default(now())
  messages        MessageRequest[]
  commands        DeviceCommand[]
}

model DeviceCommand {
  id        String         @id @default(cuid())
  deviceId  String
  device    WhatsAppDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type      CommandType
  payload   Json           @default("{}")
  done      Boolean        @default(false)
  result    String?
  createdAt DateTime       @default(now())

  @@index([deviceId, done])
}

model EmailValidation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  verdict   String
  checks    Json
  charge    Decimal  @default(0) @db.Decimal(12, 6)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Ticket {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  subject    String
  category   String         @default("general")
  priority   TicketPriority @default(NORMAL)
  status     TicketStatus   @default(OPEN)
  assignedId String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages   TicketMessage[]

  @@index([tenantId])
  @@index([status])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  authorRole Role
  body       String
  internal   Boolean  @default(false)
  attachName String?
  attachMime String?
  attachData String?
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole String?
  category  String   @default("admin")
  action    String
  target    String?
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
}

model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

model BackupMeta {
  id        String   @id @default(cuid())
  kind      String
  location  String?
  note      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}
